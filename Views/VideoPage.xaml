<Page x:Class="uYouWin.Views.VideoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uYouWin.Views"
      xmlns:controls="clr-namespace:Microsoft.Toolkit.Wpf.UI.Controls;assembly=Microsoft.Toolkit.Wpf.UI.Controls"
      xmlns:ui="http://schemas.modernwpf.com/2019"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VideoPage"
      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageLayout" Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="VideoRow" Height="2*" />
            <RowDefinition x:Name="DetailsRow" Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="DetailsView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock x:Name="VideoTitle" FontSize="22" TextWrapping="Wrap" />
                    <Button x:Name="ChannelButton" HorizontalAlignment="Left" Margin="0,8" Click="ChannelButton_Click" />
                    <Button Content="Save to playlist" HorizontalAlignment="Left" Click="SaveToPlaylist_Click" />
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,12" />
                    <TextBlock Text="Comments" FontSize="18" Margin="0,8" />
                    <TextBlock x:Name="CommentsStatus" TextWrapping="Wrap" />
                    <ItemsControl x:Name="CommentsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8">
                                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Related videos" FontSize="18" />
                    <TextBlock x:Name="RelatedStatus" TextWrapping="Wrap" />
                    <ListBox x:Name="RelatedList" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="RelatedList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8">
                                    <Image Source="{Binding ThumbnailUrl}" Height="100" Stretch="Uniform" />
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ChannelTitle}" />
                                    <local:AddToPlaylistButton />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    <Grid
        x:Name="RootGrid"
        Background="Black"
        ClipToBounds="True"
        MouseMove="RootGrid_MouseMove"
        MouseLeave="RootGrid_MouseLeave"
        MouseLeftButtonDown="RootGrid_MouseLeftButtonDown"
        SizeChanged="RootGrid_SizeChanged">

        <!-- The viewport bounds the native HWND; the toolkit owns UWP/DPI layout. -->
        <local:VideoViewport ClipToBounds="True">
            <controls:MediaPlayerElement
                x:Name="VideoPlayerElement"
                Loaded="VideoPlayerElement_Loaded"
                AreTransportControlsEnabled="False"
                Stretch="Uniform" />
        </local:VideoViewport>

        <!--
            controls:MediaPlayerElement wraps a UWP XAML Island (HwndHost),
            which always paints on top of every other WPF element that
            shares its window ("airspace"), no matter their z-order. Any
            sibling WPF overlay (the media controls, the playlist panel)
            would therefore be invisible behind the video surface.

            Popups are separate top-level windows and are not subject to
            that restriction, so both overlays below are implemented as
            Popups positioned/sized in code-behind to track RootGrid.
        -->

        <!-- OSD-style playlist panel, flies out from the right -->
        <Popup
            x:Name="PlaylistPopup"
            Placement="Relative"
            PlacementTarget="{Binding ElementName=RootGrid}"
            AllowsTransparency="True"
            StaysOpen="True"
            IsOpen="False">
            <Border
                x:Name="PlaylistPanel"
                Width="280"
                Background="#B31E1E1E"
                RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PlaylistPanelTransform" X="280" />
                </Border.RenderTransform>

                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Playlist"
                        Foreground="White"
                        FontSize="16"
                        Margin="0,0,0,8" />

                    <ListBox
                        x:Name="PlaylistListBox"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseDoubleClick="PlaylistListBox_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="White" />
                                    <local:AddToPlaylistButton />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <!-- Controls overlay, visible on hover while in fullscreen -->
        <Popup
            x:Name="ControlsPopup"
            Placement="Relative"
            PlacementTarget="{Binding ElementName=RootGrid}"
            AllowsTransparency="True"
            StaysOpen="True"
            IsOpen="False">
            <Grid
                x:Name="ControlsOverlay"
                Background="#AA000000">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Slider
                    x:Name="ScrubBar"
                    Grid.Row="0"
                    Margin="12,8,12,0"
                    Minimum="0"
                    Maximum="100"
                    IsMoveToPointEnabled="True"
                    Thumb.DragStarted="ScrubBar_DragStarted"
                    Thumb.DragCompleted="ScrubBar_DragCompleted"
                    PreviewMouseLeftButtonDown="ScrubBar_PreviewMouseLeftButtonDown" />

                <Grid Grid.Row="1" Margin="12,4,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        x:Name="LastButton"
                        Style="{StaticResource VideoIconButtonStyle}"
                        Width="36" Height="36"
                        Click="LastButton_Click"
                        ToolTip="Previous video">
                        <Image Source="/Assets/icons/prev.png" Width="20" Height="20" />
                    </Button>

                    <Button
                        Grid.Column="1"
                        x:Name="PlayPauseButton"
                        Style="{StaticResource VideoIconButtonStyle}"
                        Width="36" Height="36"
                        Click="PlayPauseButton_Click">
                        <Image x:Name="PlayPauseIcon" Source="/Assets/icons/pause.png" Width="20" Height="20" />
                    </Button>

                    <Button
                        Grid.Column="2"
                        x:Name="StopButton"
                        Width="36" Height="36"
                        Click="StopButton_Click">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE71A;" />
                    </Button>

                    <Button
                        Grid.Column="3"
                        x:Name="NextButton"
                        Style="{StaticResource VideoIconButtonStyle}"
                        Width="36" Height="36"
                        Click="NextButton_Click"
                        ToolTip="Next video">
                        <Image Source="/Assets/icons/next.png" Width="20" Height="20" />
                    </Button>

                    <StackPanel
                        Grid.Column="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">

                        <Button
                            x:Name="SeekBackButton"
                            Style="{StaticResource VideoIconButtonStyle}"
                            Width="36" Height="36"
                            Click="SeekBackButton_Click"
                            ToolTip="Back 5 seconds">
                            <Image Source="/Assets/icons/rwd.png" Width="20" Height="20" />
                        </Button>

                        <Button
                            x:Name="SeekForwardButton"
                            Style="{StaticResource VideoIconButtonStyle}"
                            Width="36" Height="36"
                            Margin="4,0,0,0"
                            Click="SeekForwardButton_Click"
                            ToolTip="Forward 5 seconds">
                            <Image Source="/Assets/icons/fwd.png" Width="20" Height="20" />
                        </Button>
                    </StackPanel>

                    <Button
                        Grid.Column="5"
                        x:Name="SubtitleButton"
                        Width="36" Height="36"
                        Click="SubtitleButton_Click"
                        ToolTip="Subtitles on/off">
                        <ui:FontIcon x:Name="SubtitleIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xED1E;" />
                    </Button>

                    <Button
                        Grid.Column="6"
                        x:Name="VolumeButton"
                        Width="36" Height="36"
                        Click="VolumeButton_Click"
                        ToolTip="Volume">
                        <ui:FontIcon x:Name="VolumeIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE995;" />
                    </Button>

                    <Popup
                        x:Name="VolumePopup"
                        Grid.Column="6"
                        PlacementTarget="{Binding ElementName=VolumeButton}"
                        Placement="Top"
                        StaysOpen="False"
                        IsOpen="False">
                        <Border
                            Background="#EE1E1E1E"
                            CornerRadius="4"
                            Padding="8">
                            <Slider
                                x:Name="VolumeSlider"
                                Width="28"
                                Height="120"
                                Orientation="Vertical"
                                Minimum="0"
                                Maximum="1"
                                Value="1"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        </Border>
                    </Popup>

                    <Button
                        Grid.Column="7"
                        x:Name="MoreButton"
                        Width="36" Height="36"
                        Click="MoreButton_Click"
                        ToolTip="Audio, subtitles &amp; info">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE712;" />
                    </Button>

                    <Popup
                        x:Name="MorePopup"
                        Grid.Column="7"
                        PlacementTarget="{Binding ElementName=MoreButton}"
                        Placement="Top"
                        StaysOpen="False"
                        IsOpen="False">
                        <Border
                            Background="#EE1E1E1E"
                            CornerRadius="4"
                            Padding="12"
                            MinWidth="220">
                            <StackPanel>
                                <TextBlock
                                    Text="Audio track"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="0,0,0,4" />
                                <ComboBox x:Name="AudioTrackComboBox" Margin="0,0,0,12" />

                                <TextBlock
                                    Text="Subtitles"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="0,0,0,4" />
                                <ComboBox x:Name="SubtitleTrackComboBox" Margin="0,0,0,12" />

                                <TextBlock
                                    Text="Video info"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="0,0,0,4" />
                                <TextBlock
                                    x:Name="VideoInfoTextBlock"
                                    Foreground="#CCFFFFFF"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button
                        Grid.Column="8"
                        x:Name="PlaylistToggleButton"
                        Width="36" Height="36"
                        Margin="8,0,0,0"
                        Click="PlaylistToggleButton_Click"
                        ToolTip="Playlist">
                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8FD;" />
                    </Button>

                    <Button
                        Grid.Column="9"
                        x:Name="FullScreenButton"
                        Width="36" Height="36"
                        Margin="4,0,0,0"
                        Click="FullScreenButton_Click"
                        ToolTip="Fullscreen">
                        <ui:FontIcon x:Name="FullScreenIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE740;" />
                    </Button>
                </Grid>
            </Grid>
        </Popup>
    </Grid>
    </Grid>
</Page>
